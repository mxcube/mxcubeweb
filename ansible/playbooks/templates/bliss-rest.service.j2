[Unit]
Description=Bliss REST API Server ({{ vm_context }})
After=network.target bliss-demo-servers-{{ vm_context }}.service
Wants=bliss-demo-servers-{{ vm_context }}.service

[Service]
Type=simple
User={{ service_user }}
Group=esrfusers
WorkingDirectory={{ install_base_path }}/bliss

# Environment variables
Environment="BEACON_HOST=localhost:10001"
Environment="TANGO_HOST=localhost:10000"

# Start command - activate conda environment and run bliss session with REST enabled
# Using --server for server mode and --no-tmux to run without tmux
ExecStart={{ install_base_path }}/miniconda/bin/conda run --no-capture-output -n bliss_dev bliss -s demo_session --server --no-tmux

# Give demo servers time to start
ExecStartPre=/bin/sleep 10

# Restart policy
Restart=on-failure
RestartSec=15

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bliss-rest-{{ vm_context }}

[Install]
WantedBy=multi-user.target