<equipment class = "SSRF.BL19U1.LimaPilatusDetector">
  <object href="/dtox" role="detector_distance"/>
  <lima_device>lima/limaccd/1</lima_device>
  <pilatus_device>lima/limaccd/detpilatus</pilatus_device>
  <channel type="tango" polling="500" name="state">State</channel>
  <channel type="tango" name="threshold">threshold</channel>
  <command type="tango" name="set_energy">SetEnergy</command>
  <command type="tango" name="set_header">SetMxSettings</command>


  <type>pilatus</type>
  <model>2M</model>
  <manufacturer>DECTRIS</manufacturer>
  <px>0.172</px>
  <py>0.172</py>
  <exposure_limits>0.05,100</exposure_limits>
  <minimum_exposure_time>0.05</minimum_exposure_time>
  <default_exposure_time>0.10</default_exposure_time>
  <!--file_suffix>tiff</file_suffix-->
  <file_suffix>cbf</file_suffix>
  <!--  <saving_format>CBF</saving_format>-->
  <width>1475</width>
  <height>1679</height>
  <minE>6</minE>
  <deadtime>0.0023</deadtime>
  <buffer>/ramdisk/BL19U11</buffer>
  <set_latency_time>True</set_latency_time>
  <trigger_mode>exts</trigger_mode>
  <user>root</user>
  <control>10.30.63.181</control>
    <beam>
      <ax>0.000336</ax>
      <ay>0.001161</ay>
      <bx>738</bx>
      <by>840</by>
  </beam>
  <pixel_size># Pixel_size 172e-6 m x 172e-6 m</pixel_size>
</equipment>





